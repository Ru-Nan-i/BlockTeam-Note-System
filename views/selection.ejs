<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline';">
    <title>콘텐츠 선택</title>
    <link rel="stylesheet" href="../assets/style.css">
    <style>
        body { 
            margin: 0; padding: 0; 
            background-color: var(--bg-base); 
            height: 100vh; overflow: hidden;
            display: flex; flex-direction: column;
        }
        
        /* 1. 상단 타이틀 영역 */
        .header { 
            height: 54px; background: var(--bg-base); 
            border-bottom: 1px solid var(--border-color);
            display: flex; justify-content: space-between; align-items: center; 
            padding: 0 26px; flex-shrink: 0;
        }
        .title { color: var(--text-primary); font-size: 1.18em; font-weight: bold; }
        
        /* 로그아웃 버튼 */
        .logout-btn { 
            background: var(--bg-control); 
            color: var(--text-primary); 
            border: 1px solid var(--border-color); 
            width: auto !important;
            flex-grow: 0 !important;
            padding: 0 15px !important; 
            font-size: 13px !important;
            height: 31px !important;       
            line-height: 29px !important;  
            border-radius: 5px; 
            cursor: pointer; 
            font-weight: bold;
            margin: 0 0 0 auto; 
            transition: 0.15s;
        }
        .logout-btn:hover {
            background: var(--danger-color);
            color: #ffffff;
            border-color: var(--danger-hover);
        }

        /* 2. 메인 컨텐츠 (좌우 분할) */
        .main-container {
            display: flex; flex: 1; overflow: hidden;
        }

        /* [왼쪽] 탐색 사이드바 */
        .dept-sidebar {
            width: 245px; background: var(--bg-base); 
            border-right: 1px solid var(--border-color);
            display: flex; flex-direction: column;
            padding: 14px 12px; overflow-y: auto;
        }
        .dept-item {
            position: relative;
            padding: 12px 15px; margin-bottom: 4px; border-radius: 5px;
            color: var(--text-secondary); cursor: pointer; font-weight: bold; font-size: 0.96em;
            transition: 0.12s;
        }
        .dept-item:hover { background: var(--bg-panel); color: var(--text-primary); }
        .dept-item.consult-item {
            color: var(--text-primary);
            margin-bottom: 10px;
            padding-bottom: 13px;
            border-bottom: 1px solid var(--border-color);
            border-radius: 5px 5px 0 0;
        }
        .dept-item.active { 
            background: var(--bg-panel); color: var(--text-primary); 
        }
        .dept-item.active::before {
            content: '';
            position: absolute;
            left: 0; top: 9px; bottom: 9px;
            width: 3px;
            border-radius: 2px;
            background: var(--accent-primary);
        }

        /* [오른쪽] 항목 목록 영역 */
        .patient-area {
            flex: 1; padding: 24px 28px; overflow-y: auto;
            display: flex; flex-direction: column;
            background: var(--bg-base);
        }

        /* 검색창 */
        .search-box { 
            background: var(--bg-panel); border: 1px solid var(--border-color); 
            padding: 11px 14px; border-radius: 6px; color: var(--text-primary); 
            width: 100%; font-size: 0.98em; margin: 0 0 22px 0; box-sizing: border-box;
        }
        .search-box:focus { 
            background: var(--bg-input);
            border-color: #545861; 
        }

        .section-heading {
            color: var(--text-primary);
            margin: 0 0 16px 0;
            font-size: 1.15em;
            font-weight: bold;
        }

        /* 항목 그리드 */
        .patient-grid { 
            display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); 
            gap: 14px; 
        }

        /* 카드 디자인 */
        .patient-card {
            background: var(--bg-panel); border-radius: 6px; padding: 18px 20px;
            border: 1px solid var(--border-color);
            cursor: pointer; transition: background-color 0.14s, border-color 0.14s;
            display: flex; flex-direction: column;
            box-sizing: border-box;
        }
        .patient-card:hover { 
            background: var(--bg-elevated);
            border-color: var(--border-hover);
        }

        .p-name { 
            color: var(--text-primary); font-size: 1.24em; font-weight: bold; 
            margin-bottom: 6px; word-break: keep-all;
        }
        .p-id-wrap {
            margin-bottom: 12px;
        }
        .p-id { 
            color: #9ea2aa; font-size: 0.88em; font-family: Consolas, monospace; 
            background: var(--bg-input); border: 1px solid var(--border-color);
            display: inline-block; padding: 2px 7px; 
            border-radius: 4px; width: fit-content;
        }
        
        /* 담당의 표시 (상단 구분선 복원 + 우측 영문 3글자 배지 정렬) */
        .p-incharge { 
            color: #cfd2d8; font-size: 0.9em; font-weight: bold; margin-top: auto; 
            padding-top: 9px; border-top: 1px solid var(--border-color);
            display: flex; align-items: center; justify-content: space-between; gap: 8px;
        }

        .incharge-text {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .dept-badge {
            background: var(--bg-control);
            color: #dcdde0;
            border: 1px solid var(--border-hover);
            font-size: 0.78em;
            font-weight: bold;
            padding: 2px 7px;
            border-radius: 4px;
            flex-shrink: 0;
            letter-spacing: 0.4px;
        }

        /* 우측 하단 고정 버전 태그 */
        .selection-app-version {
            position: fixed;
            bottom: 14px;
            right: 22px;
            color: var(--text-muted);
            font-size: 0.8em;
            font-family: Consolas, 'Courier New', monospace;
            pointer-events: none;
            z-index: 100;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="title">콘텐츠 선택 (Contents Selection)</div>
        <button class="logout-btn" onclick="window.location.href='login.ejs'">로그아웃</button>
    </div>

    <div class="main-container">
        <div class="dept-sidebar" id="dept-list">
            <div style="color:var(--text-muted); text-align:center; margin-top:20px;">로딩중...</div>
        </div>

        <div class="patient-area">
            <input type="text" id="search" class="search-box" placeholder="🔍 선택된 콘텐츠 내 검색..." onkeyup="filterPatients()">
            
            <h3 id="current-dept-title" class="section-heading">
                ◀ 왼쪽에서 콘텐츠를 선택하세요
            </h3>
            
            <div id="grid" class="patient-grid"></div>
        </div>
    </div>

    <div class="selection-app-version" id="selection-app-version"></div>

    <script>
        let allDepts = [];
        let allPatients = [];
        let doctorList = [];
        let currentDeptId = null;

        window.onload = () => {
            window.electronAPI.send('request-app-version');
            requestData();
            setInterval(requestData, 3000);
        };

        window.electronAPI.on('receive-app-version', (version) => {
            const verEl = document.getElementById('selection-app-version');
            if (verEl) verEl.innerText = `v${version}`;
        });

        function requestData() {
            window.electronAPI.send('request-metadata');
        }

        window.electronAPI.on('receive-metadata', (data) => {
            allDepts = data.departments || [];
            allPatients = data.patients || [];
            doctorList = data.users || []; 

            const sidebar = document.getElementById('dept-list');
            const currentItemCount = sidebar.querySelectorAll('.dept-item').length;
            const newItemCount = allDepts.length + 1;

            if (currentItemCount !== newItemCount) {
                renderDepartments();
            }
            
            if (currentDeptId) {
                filterPatients();
            }
        });

        function renderDepartments() {
            const sidebar = document.getElementById('dept-list');
            sidebar.innerHTML = ''; 

            const savedDeptId = sessionStorage.getItem('lastSelectedDeptId');
            const savedDeptName = sessionStorage.getItem('lastSelectedDeptName');
            let targetElement = null;

            const consultDiv = document.createElement('div');
            consultDiv.className = 'dept-item consult-item';
            consultDiv.innerText = '전체 검색';
            consultDiv.onclick = () => selectDept('CONSULT', '전체', consultDiv);
            sidebar.appendChild(consultDiv);

            if (savedDeptId === 'CONSULT') {
                targetElement = consultDiv;
            }

            if (allDepts.length === 0) {
                sidebar.innerHTML += '<div style="padding:10px; color:var(--text-muted);">등록된 콘텐츠 없음</div>';
            } else {
                allDepts.forEach(d => {
                    const div = document.createElement('div');
                    div.className = 'dept-item';
                    div.innerText = d.name; 
                    div.onclick = () => selectDept(d.id, d.name, div);
                    sidebar.appendChild(div);

                    if (savedDeptId === d.id) {
                        targetElement = div;
                    }
                });
            }

            if (savedDeptId && targetElement && !currentDeptId) {
                selectDept(savedDeptId, savedDeptName || '', targetElement);
            }
        }

        function selectDept(deptId, deptName, element) {
            currentDeptId = deptId;
            
            sessionStorage.setItem('lastSelectedDeptId', deptId);
            sessionStorage.setItem('lastSelectedDeptName', deptName);

            const items = document.querySelectorAll('.dept-item');
            items.forEach(i => i.classList.remove('active'));
            if(element) element.classList.add('active');

            if (deptId === 'CONSULT') {
                document.getElementById('current-dept-title').innerText = `전체 항목`;
                document.getElementById('search').placeholder = "🔍 전체 항목 중 이름 또는 번호 검색...";
            } else {
                document.getElementById('current-dept-title').innerText = `${deptName}`;
                document.getElementById('search').placeholder = "🔍 선택된 콘텐츠 내 검색...";
            }
            
            document.getElementById('search').value = '';
            filterPatients();
        }

        function filterPatients() {
            if (!currentDeptId) return; 

            const keyword = document.getElementById('search').value.toLowerCase();
            
            const filtered = allPatients.filter(p => {
                const matchDept = (currentDeptId === 'CONSULT') ? true : (p.deptId === currentDeptId);
                const matchKeyword = p.name.toLowerCase().includes(keyword) || p.id.toLowerCase().includes(keyword);
                return matchDept && matchKeyword;
            });

            renderPatientGrid(filtered);
        }

        function renderPatientGrid(list) {
            const grid = document.getElementById('grid');
            grid.innerHTML = '';

            if (list.length === 0) {
                grid.innerHTML = '<div style="color:var(--text-muted); padding:20px 0; font-size:1.05em; grid-column: 1 / -1;">해당 조건의 항목이 없습니다.</div>';
                return;
            }

            const fragment = document.createDocumentFragment();

            list.forEach(p => {
                let inChargeText = '<span style="color:var(--text-muted); font-weight:normal;">배정 안됨</span>';
                if (p.inChargeId) {
                    const doc = doctorList.find(u => u.id === p.inChargeId);
                    if (doc) {
                        const major = doc.major ? `(${doc.major})` : '';
                        inChargeText = `${doc.name} ${major}`;
                    } else {
                        inChargeText = `${p.inChargeId}`;
                    }
                }

                const div = document.createElement('div');
                div.className = 'patient-card';
                div.onclick = () => {
                    window.electronAPI.send('patient-selected', p); 
                };
                
                const deptTag = (currentDeptId === 'CONSULT' && p.deptId) 
                    ? `<span class="dept-badge">${p.deptId}</span>` 
                    : '';

                div.innerHTML = `
                    <div class="p-name">${p.name}</div>
                    <div class="p-id-wrap"><span class="p-id">${p.id}</span></div>
                    <div class="p-incharge">
                        <span class="incharge-text">${inChargeText}</span>
                        ${deptTag}
                    </div>
                `;
                fragment.appendChild(div);
            });

            grid.appendChild(fragment);
        }
    </script>
</body>
</html>