<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline';">
    <title>BlockTeam-Note-Data 로그인</title>
    <link rel="stylesheet" href="../assets/style.css">
    <style>
        .copyright {
            position: fixed; bottom: 20px; left: 25px; 
            color: #72767d; font-size: 0.8em; font-family: sans-serif; 
            opacity: 0.7; pointer-events: none;
        }
        
        .loading-overlay {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            background: #2f3136; z-index: 9999;
            display: none; flex-direction: column; justify-content: center; align-items: center;
            opacity: 0; transition: opacity 0.3s ease; 
        }

        .logo-loader-container {
            position: relative;
            width: 150px;
            height: 150px;
            margin-bottom: 25px;
        }
        
        .logo-bg {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            object-fit: contain;
            opacity: 0.2; 
            filter: grayscale(100%); 
        }
        
        .logo-fill {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            object-fit: contain;
            animation: fill-up 2s cubic-bezier(0.4, 0.0, 0.2, 1) infinite; 
        }
       
        @keyframes fill-up {
            0% { clip-path: inset(100% 0 0 0); } 
            50% { clip-path: inset(0 0 0 0); }   
            100% { clip-path: inset(100% 0 0 0); } 
        }
        
        .loading-text { color: #fff; font-size: 1.3em; font-weight: bold; font-family: 'Segoe UI', sans-serif;}
        .loading-subtext { color: #b9bbbe; margin-top: 10px; font-size: 0.9em; font-family: 'Segoe UI', sans-serif;}

        button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
    </style>
</head>
<body>
    <div id="loading-overlay" class="loading-overlay">
        <div class="logo-loader-container">
            <img src="../assets/logoX.png" class="logo-bg">
            <img src="../assets/logoX.png" class="logo-fill">
        </div>
        <div id="loading-title" class="loading-text">보안 세션 인증 중...</div>
        <div id="loading-desc" class="loading-subtext">데이터를 안전하게 동기화하고 있습니다. 잠시만 기다려주세요.</div>
    </div>

    <div class="login-wrapper">
        <div class="login-box">
            <h2 style="color: #eeeeee;">BlockTeam Note Data</h2>
            <input type="text" id="uid" placeholder="ID" autocomplete="off">
            <input type="password" id="upw" placeholder="Password">
            <button id="btn-login" onclick="tryLogin()">Login System</button>
            <p id="msg" style="color: #ed4245; font-size: 0.9em; margin-top: 10px;"></p>
        </div>
    </div>

    <div class="copyright">
        &copy; 2026 BlockTeam. All rights reserved.
    </div>

    <script>
        const overlay = document.getElementById('loading-overlay');
        const loginBtn = document.getElementById('btn-login');
        const msgEl = document.getElementById('msg');

        function showLoading(title, desc) {
            if (title) document.getElementById('loading-title').innerText = title;
            if (desc) document.getElementById('loading-desc').innerText = desc;
            overlay.style.display = 'flex';
            setTimeout(() => { overlay.style.opacity = '1'; }, 10);
            loginBtn.disabled = true;
        }

        function hideLoading() {
            overlay.style.opacity = '0';
            setTimeout(() => {
                overlay.style.display = 'none';
                loginBtn.disabled = false;
            }, 300);
        }

        function tryLogin() {
            const id = document.getElementById('uid').value.trim();
            const password = document.getElementById('upw').value.trim();

            if (!id || !password) {
                msgEl.innerText = '아이디와 비밀번호를 모두 입력해주세요.';
                return;
            }

            msgEl.innerText = '';
            showLoading('보안 세션 인증 및 데이터 로딩 중...', '드라이브와 통신하여 세션 토큰을 확인하고 있습니다.');
            window.electronAPI.send('request-login', { id, password });
        }

        window.electronAPI.on('login-failed', (msg) => {
            hideLoading();
            msgEl.innerText = msg || '로그인에 실패했습니다.';
        });

        document.getElementById('upw').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') tryLogin();
        });

        document.getElementById('uid').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') document.getElementById('upw').focus();
        });
    </script>
</body>
</html>