<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline';">
    <title>BlockTeam-Note-Data 로그인</title>
    <link rel="stylesheet" href="../assets/style.css">
    <style>
        /* 로그인 카드 상단 브랜드 로고 배지 (logoX.png 사용) */
        .brand-emblem {
            width: 66px;
            height: 66px;
            margin: 0 auto 16px auto;
            border-radius: 15px;
            background: #f2f3f5;
            border: 1px solid rgba(255, 255, 255, 0.16);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.35);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 4px;
            box-sizing: border-box;
            overflow: hidden;
        }

        .brand-emblem img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            transform: scale(1.12);
            pointer-events: none;
            user-select: none;
        }

        .copyright {
            position: fixed; bottom: 20px; left: 25px; 
            color: var(--text-muted); font-size: 0.8em; font-family: sans-serif; 
            pointer-events: none;
        }

        .app-version {
            position: fixed; bottom: 20px; right: 25px; 
            color: var(--text-muted); font-size: 0.8em; font-family: Consolas, 'Courier New', monospace; 
            pointer-events: none;
        }
        
        .loading-overlay {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            background: var(--bg-base); z-index: 9999;
            display: none; flex-direction: column; justify-content: center; align-items: center;
            opacity: 0; transition: opacity 0.3s ease; 
        }

        .logo-loader-container {
            position: relative;
            width: 140px;
            height: 140px;
            margin-bottom: 22px;
        }
        
        .logo-bg {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            object-fit: contain;
            opacity: 0.2; 
            filter: grayscale(100%); 
        }
        
        .logo-fill {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            object-fit: contain;
            animation: fill-up 2s cubic-bezier(0.4, 0.0, 0.2, 1) infinite; 
        }
       
        @keyframes fill-up {
            0% { clip-path: inset(100% 0 0 0); } 
            50% { clip-path: inset(0 0 0 0); }   
            100% { clip-path: inset(100% 0 0 0); } 
        }
        
        .loading-text { color: var(--text-primary); font-size: 1.3em; font-weight: bold; font-family: 'Segoe UI', 'Malgun Gothic', sans-serif; }
        .loading-subtext { color: var(--text-secondary); margin-top: 10px; font-size: 0.9em; font-family: 'Segoe UI', 'Malgun Gothic', sans-serif; }

        button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
    </style>
</head>
<body>
    <div id="loading-overlay" class="loading-overlay">
        <div class="logo-loader-container">
            <img src="../assets/logoX.png" class="logo-bg">
            <img src="../assets/logoX.png" class="logo-fill">
        </div>
        <div id="loading-title" class="loading-text">보안 세션 인증 중...</div>
        <div id="loading-desc" class="loading-subtext">데이터를 안전하게 동기화하고 있습니다. 잠시만 기다려주세요.</div>
    </div>

    <div class="login-wrapper">
        <div class="login-box">
            <div class="brand-emblem">
                <img src="../assets/logoX.png" alt="BlockTeam Logo">
            </div>
            <h2 style="color: var(--text-primary); margin-top: 0; margin-bottom: 6px; font-weight: bold;">BlockTeam Note Data</h2>
            <div style="font-size: 0.85em; color: var(--text-muted); margin-bottom: 20px;">계정 정보를 입력하여 로그인하세요</div>
            <input type="text" id="uid" placeholder="ID" autocomplete="off">
            <input type="password" id="upw" placeholder="Password">
            <button id="btn-login" onclick="tryLogin()">Login System</button>
            <p id="msg" style="color: #ff8a80; font-size: 0.9em; margin-top: 12px; margin-bottom: 0;"></p>
        </div>
    </div>

    <div class="copyright">
        &copy; 2026 BlockTeam. All rights reserved.
    </div>

    <div class="app-version" id="login-app-version"></div>

    <script>
        const overlay = document.getElementById('loading-overlay');
        const loginBtn = document.getElementById('btn-login');
        const msgEl = document.getElementById('msg');

        window.electronAPI.send('request-app-version');
        window.electronAPI.on('receive-app-version', (version) => {
            const verEl = document.getElementById('login-app-version');
            if (verEl) verEl.innerText = `v${version}`;
        });

        function showLoading(title, desc) {
            if (title) document.getElementById('loading-title').innerText = title;
            if (desc) document.getElementById('loading-desc').innerText = desc;
            overlay.style.display = 'flex';
            setTimeout(() => { overlay.style.opacity = '1'; }, 10);
            loginBtn.disabled = true;
        }

        function hideLoading() {
            overlay.style.opacity = '0';
            setTimeout(() => {
                overlay.style.display = 'none';
                loginBtn.disabled = false;
            }, 300);
        }

        function tryLogin() {
            const id = document.getElementById('uid').value.trim();
            const password = document.getElementById('upw').value.trim();

            if (!id || !password) {
                msgEl.innerText = '아이디와 비밀번호를 모두 입력해주세요.';
                return;
            }

            msgEl.innerText = '';
            showLoading('보안 세션 인증 및 데이터 로딩 중...', '서버와 통신하여 세션 토큰을 확인하고 있습니다.');
            window.electronAPI.send('request-login', { id, password });
        }

        window.electronAPI.on('login-failed', (msg) => {
            hideLoading();
            msgEl.innerText = msg || '로그인에 실패했습니다.';
        });

        document.getElementById('upw').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') tryLogin();
        });

        document.getElementById('uid').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') document.getElementById('upw').focus();
        });
    </script>
</body>
</html>