<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="../assets/style.css">
    <style>
        body { 
            display: block !important; margin: 0; padding: 0; 
            overflow: hidden; background-color: var(--bg-base); 
        }
        .header {
            width: 100%; height: 54px; background: var(--bg-base); 
            border-bottom: 1px solid var(--border-color); 
            display: flex; justify-content: center; align-items: center; 
            box-sizing: border-box; flex-shrink: 0;
        }
        .admin-grid { 
            display: grid; grid-template-columns: 1fr 1fr; 
            gap: 20px; padding: 20px 22px; 
            height: calc(100vh - 54px); 
            box-sizing: border-box; 
            width: 100%; max-width: 1600px; margin: 0 auto;
        }
        .left-col { display: flex; flex-direction: column; height: 100%; gap: 14px; overflow-y: auto; padding-right: 4px; }
        
        .form-section { 
            background: var(--bg-panel); padding: 18px 20px; border-radius: 8px; 
            border: 1px solid var(--border-color);
            flex: 0 0 auto; 
            display: flex; flex-direction: column; gap: 9px;
        }
        
        .history-section { 
            background: var(--bg-panel); padding: 22px; border-radius: 8px; 
            border: 1px solid var(--border-color);
            overflow-y: hidden; height: 100%; display: flex; flex-direction: column;
        }
        .search-box { 
            background: var(--bg-input); border: 1px solid var(--border-color); 
            padding: 10px 12px; border-radius: 5px; color: var(--text-primary); 
            width: 100%; margin: 0 0 14px 0; font-size: 0.96em; 
        }
        input, select { 
            margin: 0; width: 100%; box-sizing: border-box; padding: 10px 12px; 
            background: var(--bg-input); border: 1px solid var(--border-color); 
            color: var(--text-primary); border-radius: 5px; 
            height: 42px; font-size: 0.94em; -webkit-app-region: no-drag !important;
            outline: none; transition: border-color 0.14s, background-color 0.14s;
        }
        input:focus, select:focus { 
            background: #161719;
            border-color: #545861; 
        }
        h3 { color: var(--text-primary); margin: 0 0 8px 0; border-bottom: 1px solid var(--border-color); padding-bottom: 8px; font-size: 1.04em; font-weight: bold; }
        label { color: var(--text-secondary); font-size: 0.85em; margin-bottom: 3px; margin-top: 4px; display:block; font-weight: bold;}
        
        button { background: var(--accent-primary); color: #ffffff; border: none; padding: 11px; width: 100%; border-radius: 5px; cursor: pointer; font-weight: bold; margin-top: auto; transition: 0.14s; }
        button:hover { background: var(--accent-hover); }
        
        .logout-btn { 
            background: var(--bg-control); color: var(--text-primary);
            border: 1px solid var(--border-color);
            margin-top: 4px; padding: 12px; font-size: 0.98em; 
        }
        .logout-btn:hover {
            background: var(--danger-color); color: #ffffff; border-color: var(--danger-hover);
        }
        
        .list-btn-group { float: right; display: flex; gap: 6px; }
        .del-btn { 
            background: var(--bg-control); color: #ff8a80;
            border: 1px solid var(--border-color);
            width: auto; padding: 4px 10px; font-size: 0.82em; margin: 0; 
        }
        .del-btn:hover { background: var(--danger-color); color: #ffffff; border-color: var(--danger-hover); }

        .pdf-btn { 
            background: var(--bg-control); color: var(--text-primary);
            border: 1px solid var(--border-color);
            width: auto; padding: 4px 10px; font-size: 0.82em; margin: 0; 
        }
        .pdf-btn:hover { background: var(--accent-primary); color: #ffffff; border-color: var(--accent-hover); }
        
        .common-badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 0.82em; font-weight: bold; vertical-align: middle; margin-right: 5px; line-height: 1.3; }
        .badge-dept { background: var(--bg-control); color: #dcdde0; border: 1px solid var(--border-hover); } 
        .badge-patient { background: var(--bg-elevated); color: var(--text-primary); } 

        .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.72); z-index: 9999; justify-content: center; align-items: center; }
        .alert-box { background: var(--bg-panel); padding: 28px; border-radius: 8px; border: 1px solid var(--border-hover); text-align: center; width: 350px; box-shadow: 0 16px 40px rgba(0,0,0,0.6); }
        .view-box { background: var(--bg-panel); padding: 28px; border-radius: 8px; border: 1px solid var(--border-hover); width: 650px; max-height: 82vh; display: flex; flex-direction: column; box-shadow: 0 16px 40px rgba(0,0,0,0.6); }
        .view-header { border-bottom: 1px solid var(--border-color); padding-bottom: 14px; margin-bottom: 14px; display: flex; justify-content: space-between; align-items: center; }
        .view-content { overflow-y: auto; flex: 1; padding-right: 8px; }
        
        .soap-row { margin-bottom: 14px; }
        .soap-label { color: var(--text-secondary); font-weight: bold; display: block; margin-bottom: 5px; font-size: 0.96em; }
        
        .soap-text { 
            background: var(--bg-input); padding: 12px 14px; border-radius: 5px; 
            color: var(--text-primary) !important; border: 1px solid var(--border-color); font-size: 0.98em; line-height: 1.6;
            white-space: pre-wrap !important; word-break: break-word;
            -webkit-user-select: text !important;
        }
        .soap-text strong, .soap-text b { color: #ffffff; font-weight: bold; }
        .soap-text u { text-decoration: underline; }
        .soap-text em, .soap-text i { font-style: italic; color: #ffffff; }
        .soap-text strike, .soap-text del { text-decoration: line-through; color: var(--text-secondary); }
        
        .soap-text code {
            background: #2f3136 !important;
            color: #e6e7ea !important;
            padding: 2px 6px !important;
            border-radius: 4px !important;
            font-family: Consolas, 'Courier New', monospace !important;
            font-size: 0.88em !important;
        }
        .soap-text pre {
            background: #141517 !important;
            border: 1px solid var(--border-color) !important;
            border-radius: 5px !important;
            padding: 10px 14px !important;
            margin: 8px 0 !important;
            overflow-x: auto !important;
            display: block !important;
            width: 100% !important;
            box-sizing: border-box !important;
        }
        .soap-text pre code {
            background: transparent !important;
            border: none !important;
            padding: 0 !important;
            color: #e6e7ea !important;
            font-family: Consolas, 'Courier New', monospace !important;
            font-size: 0.9em !important;
            line-height: 1.5 !important;
            white-space: pre !important;
            display: block !important;
        }
        .soap-text blockquote {
            border-left: 4px solid #545861; margin: 6px 0; padding: 4px 12px;
            background: rgba(255, 255, 255, 0.04); color: #cfd2d8; border-radius: 0 4px 4px 0;
        }

        .writer-name { color: #cfd2d8; font-weight: bold; }
        .writer-major { color: var(--text-secondary); font-size: 0.9em; font-weight: normal; }
        .modal-msg { color: var(--text-primary); font-size: 1.05em; margin-bottom: 20px; line-height: 1.5; }
        .modal-btn-group { display: flex; justify-content: center; gap: 10px; }
        .modal-btn { width: auto; padding: 9px 22px; margin: 0; }
    </style>
</head>
<body>
    <div id="alert-modal" class="modal-overlay">
        <div class="alert-box">
            <div id="alert-text" class="modal-msg">알림 내용</div>
            <div class="modal-btn-group">
                <button id="btn-ok" class="modal-btn" onclick="closeAlert()">확인</button>
                <button id="btn-yes" class="modal-btn" style="background:var(--danger-color); display:none;">삭제</button>
                <button id="btn-no" class="modal-btn" style="background:var(--bg-control); border:1px solid var(--border-color); display:none;" onclick="closeAlert()">취소</button>
            </div>
        </div>
    </div>

    <div id="view-modal" class="modal-overlay">
        <div class="view-box">
            <div class="view-header">
                <div>
                    <h2 style="color:var(--text-primary); margin:0; font-size: 1.2em; font-weight: bold;">📄 차팅 상세</h2>
                    <div style="color:var(--text-secondary); margin-top:5px; font-size:0.88em;">
                        항목: <span id="v-patient" style="color:var(--text-primary); font-weight:bold;">-</span> |
                        콘텐츠: <span id="v-dept" style="color:#cfd2d8; font-weight:bold;">-</span>
                    </div>
                </div>
                <div style="text-align:right;">
                    <div style="color:var(--text-muted); font-size:0.85em;" id="v-date">-</div>
                    <div style="margin-top:5px;">작성: <span id="v-writer" class="writer-name">-</span></div>
                </div>
            </div>
            
            <div class="view-content">
                <div class="soap-row"><span class="soap-label">Subjective (주관적 사실 및 설명)</span><div id="v-s" class="soap-text"></div></div>
                <div class="soap-row"><span class="soap-label">Objective (객관적 사실 및 목표)</span><div id="v-o" class="soap-text"></div></div>
                <div class="soap-row"><span class="soap-label">Assessment (진단 및 평가)</span><div id="v-a" class="soap-text"></div></div>
                <div class="soap-row"><span class="soap-label">Plan (계획)</span><div id="v-p" class="soap-text"></div></div>
            </div>
            <div style="margin-top:18px; text-align:right;">
                <button onclick="closeView()" style="width:auto; margin:0; padding:10px 26px; background:var(--bg-control); border:1px solid var(--border-color);">닫기</button>
            </div>
        </div>
    </div>

    <div id="main-app-container">
        <div class="header">
            <h2 style="margin:0; color:var(--text-primary); text-align: center; font-size: 1.12em; font-weight: bold;">
                NOTE DATA 관리자 시스템
            </h2>
        </div>

        <div class="admin-grid">
            <div class="left-col">
                <div class="form-section">
                    <h3>1. 콘텐츠 등록</h3>
                    <label>콘텐츠 ID</label> <input id="new-dept-id" placeholder="ex: MJT">
                    <label>콘텐츠 이름</label> <input id="new-dept-name" placeholder="ex: 모히또 리조트">
                    <button onclick="addDept()">추가하기</button>
                </div>
                
                <div class="form-section">
                    <h3>2. 항목 등록</h3>
                    <label>항목 이름</label> <input id="p-name" placeholder="예: 홍길동">
                    <label>차트 번호 (자동)</label> 
                    <div style="display:flex; gap:6px; margin-bottom: 4px;">
                        <input id="p-id" placeholder="생성 중..." style="background:var(--bg-input); color:#dcdde0; font-weight:bold; font-family:monospace;">
                        <button onclick="generateChartId()" style="width:42px; margin:0; padding:0; background:var(--bg-control); border:1px solid var(--border-color); font-size:1.1em;" title="새 번호 생성">🎲</button>
                    </div>
                    <label>담당</label>
                    <select id="p-incharge"><option value="">-- 담당진 로딩중 --</option></select>
                    <label>소속 콘텐츠</label> 
                    <select id="p-dept"><option value="">-- 콘텐츠 로딩중 --</option></select>
                    <button onclick="addPatient()">항목 등록</button>
                </div>
                
                <div class="form-section">
                    <h3>3. 개발진 계정</h3>
                    <label>아이디 & 비밀번호</label>
                    <div style="display:flex; gap:10px; margin-bottom: 4px;">
                        <input id="u-id" placeholder="ID" style="flex:1;"> <input id="u-pw" type="password" placeholder="PW" style="flex:1;">
                    </div>
                    <label>이름 & 분야</label>
                    <div style="display:flex; gap:10px;">
                        <input id="u-name" placeholder="이름" style="flex:1.5;"> <input id="u-major" placeholder="전공" style="flex:1;">
                    </div>
                    <label>권한</label>
                    <select id="u-role"> 
                        <option value="doctor">개발자 (Dev)</option> 
                        <option value="admin">관리자 (Admin)</option> 
                        <option value="viewer">열람 전용 (Viewer)</option>
                    </select>
                    <button onclick="addUser()" style="background: #005a9e;">계정 생성</button>
                </div>
                
                <div class="form-section">
                    <h3>4. 담당 변경</h3>
                    <label>대상 항목 선택</label>
                    <select id="update-p-id"><option value="">-- 항목 선택 --</option></select>
                    <label>새로운 담당</label>
                    <select id="update-doc-id"><option value="">-- 개발진 선택 --</option></select>
                    <button onclick="updatePatientDoctor()" style="background: #005a9e;">담당 변경</button>
                </div>
                <button class="logout-btn" onclick="window.location.href='login.ejs'">로그아웃</button>
            </div>

            <div class="history-section">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                    <h3 style="margin:0; border:none; padding:0;">📋 차팅 기록 관리</h3>
                    <button onclick="loadAllCharts()" style="width:auto; background:var(--bg-control); color:var(--text-secondary); border:1px solid var(--border-color); font-size:0.84em; padding: 4px 10px; margin:0; font-weight:bold;">🔄 새로고침</button>
                </div>
                <input type="text" id="search-input" class="search-box" placeholder="🔍 검색..." onkeyup="filterCharts()">
                <div style="flex: 1; overflow-y: auto; padding-right: 4px;">
                    <ul id="chart-list" style="list-style: none; padding: 0; margin: 0;">
                        <li style="color:var(--text-muted); text-align:center; padding:20px;">데이터 로딩중...</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <script>
        let allCharts = [];
        let existingPatientIds = []; 
        let allPatients = [];
        let allDepts = [];

        window.onload = function() { refreshAllData(); };
        function refreshAllData() {
            window.electronAPI.send('request-metadata');
            window.electronAPI.send('admin-get-charts');
        }

        function findPatientName(id, savedName) {
            const found = allPatients.find(p => p.id === id);
            if (found) return found.name;
            if (savedName) return savedName;
            return id;
        }

        function findDeptName(patientId, savedDeptName) {
            if (savedDeptName && savedDeptName !== 'Unknown') return savedDeptName;
            const foundPatient = allPatients.find(p => p.id === patientId);
            if (foundPatient && foundPatient.deptId) {
                const foundDept = allDepts.find(d => d.id === foundPatient.deptId);
                return foundDept ? foundDept.name : foundPatient.deptId;
            }
            return 'General';
        }

        function generateChartId() {
            const chars = 'abcdef0123456789';
            let newId = '';
            let isUnique = false;
            for(let k=0; k<100; k++) {
                newId = '';
                for (let i = 0; i < 7; i++) { newId += chars.charAt(Math.floor(Math.random() * chars.length)); }
                if (!existingPatientIds.includes(newId)) { isUnique = true; break; }
            }
            if(isUnique) document.getElementById('p-id').value = newId;
            else document.getElementById('p-id').value = 'P' + Date.now().toString().slice(-5);
        }

        function showAlert(msg) {
            document.getElementById('alert-text').innerText = msg;
            document.getElementById('btn-ok').style.display = 'inline-block';
            document.getElementById('btn-yes').style.display = 'none';
            document.getElementById('btn-no').style.display = 'none';
            document.getElementById('alert-modal').style.display = 'flex';
        }
        function showConfirm(msg, callback) {
            document.getElementById('alert-text').innerText = msg;
            document.getElementById('btn-ok').style.display = 'none';
            document.getElementById('btn-yes').style.display = 'inline-block';
            document.getElementById('btn-no').style.display = 'inline-block';
            document.getElementById('alert-modal').style.display = 'flex';
            const yesBtn = document.getElementById('btn-yes');
            yesBtn.onclick = function() { callback(); closeAlert(); };
        }
        function closeAlert() { document.getElementById('alert-modal').style.display = 'none'; }

        function formatViewerContent(html) {
            if (!html || html.trim() === '' || html === '-') {
                return '<span style="color:var(--text-muted);">내용 없음</span>';
            }
            return html.replace(/(<pre[\s\S]*?<\/pre>)|(<code>([\s\S]*?)<\/code>)/gi, function(match, preBlock, codeBlock, codeContent) {
                if (preBlock) return preBlock;
                if (codeContent && codeContent.includes('\n')) {
                    return '<pre><code>' + codeContent + '</code></pre>';
                }
                return match;
            });
        }

        function cleanSummary(text) {
            if (!text) return '';
            return text.replace(/<[^>]+>/g, '').trim();
        }

        function openView(item) {
            const sData = item.soapData || {};
            const writerName = item.doctorName || item.doctorId;
            const writerMajor = item.doctorMajor ? `(${item.doctorMajor})` : '';
            
            const realName = findPatientName(item.patientId, item.patientName);
            const realDept = findDeptName(item.patientId, item.deptName);

            document.getElementById('v-dept').innerText = realDept;
            document.getElementById('v-patient').innerText = `${realName} (${item.patientId})`;
            
            document.getElementById('v-writer').innerHTML = `${writerName} <span class="writer-major">${writerMajor}</span>`;
            document.getElementById('v-date').innerText = new Date(item.savedAt).toLocaleString();
            
            document.getElementById('v-s').innerHTML = formatViewerContent(sData.s || sData.S);
            document.getElementById('v-o').innerHTML = formatViewerContent(sData.o || sData.O);
            document.getElementById('v-a').innerHTML = formatViewerContent(sData.a || sData.A);
            document.getElementById('v-p').innerHTML = formatViewerContent(sData.p || sData.P);
            
            document.getElementById('view-modal').style.display = 'flex';
        }
        function closeView() { document.getElementById('view-modal').style.display = 'none'; }

        function addDept() {
            const id = document.getElementById('new-dept-id').value.trim();
            const name = document.getElementById('new-dept-name').value.trim();
            if(id && name) window.electronAPI.send('admin-add-dept', { id, name }); else showAlert('ID와 이름을 입력하세요.');
        }
        
        function addPatient() {
            const name = document.getElementById('p-name').value.trim();
            const id = document.getElementById('p-id').value.trim();
            const deptId = document.getElementById('p-dept').value;
            const inChargeId = document.getElementById('p-incharge').value;
            if(name && id && deptId && inChargeId) {
                window.electronAPI.send('admin-add-patient', { id, name, deptId, inChargeId });
            } else { showAlert('모든 정보(담당 포함)를 입력하세요.'); }
        }
        
        function addUser() {
            const id = document.getElementById('u-id').value.trim();
            const pw = document.getElementById('u-pw').value.trim();
            const name = document.getElementById('u-name').value.trim();
            const role = document.getElementById('u-role').value;
            const major = document.getElementById('u-major').value.trim();
            if(id && pw && name) window.electronAPI.send('admin-add-user', { id, pw, name, role, major }); else showAlert('필수 정보를 입력하세요.');
        }

        function updatePatientDoctor() {
            const patientId = document.getElementById('update-p-id').value;
            const doctorId = document.getElementById('update-doc-id').value;
            if (patientId && (doctorId || doctorId === 'unassigned')) {
                window.electronAPI.send('admin-update-patient', { id: patientId, inChargeId: doctorId });
            } else { showAlert('항목과 변경할 담당을 선택해주세요.'); }
        }

        function deleteChart(id) {
            showConfirm('정말 삭제하시겠습니까?', () => { window.electronAPI.send('admin-delete-chart', id); });
        }

        function saveAsPDF(item) {
            const realName = findPatientName(item.patientId, item.patientName);
            const realDept = findDeptName(item.patientId, item.deptName);
            const writerName = item.doctorName || item.doctorId;
            const writerMajor = item.doctorMajor ? `(${item.doctorMajor})` : '';
            const sData = item.soapData || {};

            const clean = (text) => (!text || text === '-') ? '' : formatViewerContent(text);
            const logoPath = window.electronAPI.logoPath || '';

            const htmlContent = `
                <!DOCTYPE html>
                <html>
                <head>
                    <meta charset="UTF-8">
                    <style>
                        @page { size: A4; margin: 15mm; }
                        body { font-family: 'Segoe UI', sans-serif; background: #fff; color: #000; padding: 0; box-sizing: border-box; }
                        .header { border-bottom: 3px solid #333; padding-bottom: 5px; margin-bottom: 15px; display: flex; justify-content: space-between; align-items: center; }
                        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 11px; }
                        td { border: 1px solid #999; padding: 6px; }
                        .td-label { background: #f0f0f0; font-weight: bold; width: 90px; text-align: center; }
                        
                        .section { margin-bottom: 20px; font-size: 11px; } 
                        .sec-title { 
                            font-size: 12px; font-weight: bold; margin-bottom: 4px; 
                            border-left: 4px solid #333; padding-left: 8px; color: #333; 
                            page-break-after: avoid; break-after: avoid; 
                        }
                        .sec-content { 
                            line-height: 1.6; background: #fbfbfb; padding: 12px; 
                            border: 1px solid #ddd; white-space: pre-wrap; 
                            min-height: 30px; word-break: break-all; 
                            widows: 2; orphans: 2; 
                        }
                        .sec-content strong, .sec-content b { font-weight: bold; }
                        .sec-content u { text-decoration: underline; }
                        .sec-content em, .sec-content i { font-style: italic; }
                        .sec-content strike, .sec-content del { text-decoration: line-through; color: #888; }
                        
                        .sec-content code { 
                            background: #f6f8fa; 
                            color: #24292f; 
                            padding: 2px 5px; 
                            border-radius: 4px; 
                            border: 1px solid #d0d7de; 
                            font-family: Consolas, 'Courier New', monospace; 
                            font-size: 10px; 
                        }

                        .sec-content pre { 
                            background: #f6f8fa; 
                            border: 1px solid #d0d7de; 
                            border-radius: 5px; 
                            padding: 10px 14px; 
                            margin: 8px 0; 
                            overflow-x: hidden; 
                            box-sizing: border-box; 
                        }
                        .sec-content pre code { 
                            background: transparent; 
                            border: none; 
                            color: #24292f; 
                            padding: 0; 
                            font-family: Consolas, 'Courier New', monospace; 
                            font-size: 10px; 
                            line-height: 1.55; 
                            white-space: pre-wrap; 
                            word-break: break-all; 
                            display: block; 
                        }

                        .sec-content blockquote { 
                            border-left: 3px solid #666; 
                            margin: 4px 0; 
                            padding: 3px 10px; 
                            background: #f0f0f0; 
                            color: #555; 
                        }
                        
                        .signature {
                            text-align: right; margin-top: 20px; padding-top: 10px; 
                            border-top: 1px solid #ccc; font-size: 12px; font-weight: bold; 
                            page-break-inside: avoid; break-inside: avoid;
                        }
                        * { -webkit-print-color-adjust: exact; color-adjust: exact; }
                    </style>
                </head>
                <body>
                    <div class="header">
                        <div>
                            <h1 style="font-size: 28px; font-weight: bold; margin: 0;">BlockTeam SUMMARY</h1>
                            <div style="font-size: 10px; color: #666; margin-top: 3px;">Printed: ${new Date().toLocaleString()}</div>
                        </div>
                        <img src="file://${logoPath}" style="height: 50px; object-fit: contain;">
                    </div>

                    <table>
                        <tr>
                            <td class="td-label">항목</td>
                            <td>${realName} (${item.patientId})</td>
                            <td class="td-label">콘텐츠</td>
                            <td>${realDept}</td>
                        </tr>
                        <tr>
                            <td class="td-label">작성일</td>
                            <td>${new Date(item.savedAt).toLocaleString()}</td>
                            <td class="td-label">작성자</td>
                            <td>${writerName} ${writerMajor}</td>
                        </tr>
                    </table>

                    <div class="section"><div class="sec-title">Subjective (주관적 사실 및 설명)</div><div class="sec-content">${clean(sData.s || sData.S)}</div></div>
                    <div class="section"><div class="sec-title">Objective (객관적 사실 및 목표)</div><div class="sec-content">${clean(sData.o || sData.O)}</div></div>
                    <div class="section"><div class="sec-title">Assessment (진단 및 평가)</div><div class="sec-content">${clean(sData.a || sData.A)}</div></div>
                    <div class="section"><div class="sec-title">Plan (계획)</div><div class="sec-content">${clean(sData.p || sData.P)}</div></div>

                    <div class="signature">
                        전자서명자: ${writerName} ${writerMajor}
                    </div>
                </body>
                </html>
            `;

            const datePart = new Date(item.savedAt).toISOString().slice(0,10);
            const safeName = realName.replace(/[\\/:*?"<>|]/g, ""); 
            const filename = `${safeName}(${item.patientId})_${datePart}.pdf`;

            window.electronAPI.send('generate-real-pdf', { html: htmlContent, filename: filename });
        }

        window.electronAPI.on('action-result', (msg) => {
            showAlert(msg);
            const ids = ['new-dept-id', 'new-dept-name', 'p-name', 'u-id', 'u-pw', 'u-name', 'u-major'];
            ids.forEach(id => document.getElementById(id).value = '');
            document.getElementById('p-incharge').value = '';
            document.getElementById('p-dept').value = '';
            document.getElementById('u-role').value = 'doctor';
            document.getElementById('update-p-id').value = '';
            document.getElementById('update-doc-id').value = '';
            generateChartId();
            refreshAllData();
        });

        function filterCharts() {
            const keyword = document.getElementById('search-input').value.toLowerCase();
            const filtered = allCharts.filter(c => {
                const pName = findPatientName(c.patientId, c.patientName).toLowerCase();
                return (c.patientId && c.patientId.toLowerCase().includes(keyword)) ||
                       (pName && pName.includes(keyword));
            });
            renderCharts(filtered);
        }
        function loadAllCharts() { refreshAllData(); }

        window.electronAPI.on('receive-metadata', (data) => {
            allPatients = data.patients || [];
            allDepts = data.departments || [];
            
            const deptSelect = document.getElementById('p-dept');
            deptSelect.innerHTML = '<option value="">-- 콘텐츠 --</option>';
            
            if (data.departments) data.departments.forEach(d => deptSelect.innerHTML += `<option value="${d.id}">${d.name}</option>`);

            const docSelect = document.getElementById('p-incharge');
            const updateDocSelect = document.getElementById('update-doc-id');
            const currentDoc = docSelect.value;
            
            const docOptions = '<option value="">-- 개발진 선택 --</option>';
            docSelect.innerHTML = docOptions;
            updateDocSelect.innerHTML = '<option value="">-- 변경할 개발진 선택 --</option>';
            updateDocSelect.innerHTML += `<option value="unassigned" style="color:#ff8a80; font-weight:bold;">⛔ 배정 해제 (None)</option>`;

            if (data.users) {
                data.users.forEach(u => {
                    if(u.role === 'doctor' || u.role === 'admin') {
                        const majorText = u.major ? `(${u.major})` : '';
                        const opt = `<option value="${u.id}">${u.name} ${majorText}</option>`;
                        docSelect.innerHTML += opt;
                        updateDocSelect.innerHTML += opt;
                    }
                });
            }
            if(currentDoc) docSelect.value = currentDoc;

            const updatePatientSelect = document.getElementById('update-p-id');
            updatePatientSelect.innerHTML = '<option value="">-- 항목 선택 --</option>';
            if (data.patients) {
                existingPatientIds = data.patients.map(p => p.id);
                data.patients.forEach(p => {
                    updatePatientSelect.innerHTML += `<option value="${p.id}">${p.name} (${p.id})</option>`;
                });
            }

            if (!document.getElementById('p-id').value) generateChartId();
            if (allCharts.length > 0) renderCharts(allCharts);
        });

        window.electronAPI.on('admin-charts-data', (list) => {
            allCharts = list.reverse();
            renderCharts(allCharts);
        });

        function renderCharts(list) {
            const ul = document.getElementById('chart-list');
            ul.innerHTML = '';
            if(!list || list.length === 0) {
                ul.innerHTML = '<li style="color:var(--text-muted); text-align:center; padding:20px;">데이터 없음</li>';
                return;
            }
            const fragment = document.createDocumentFragment();

            list.forEach(c => {
                const li = document.createElement('li');
                li.style.cssText = 'background:#1b1c1e; margin-bottom:9px; border-radius:6px; padding:14px 16px; border:1px solid #323439; cursor:pointer; transition:0.12s;';
                li.onmouseover = function() { this.style.borderColor = '#45484f'; this.style.background = '#2b2d31'; };
                li.onmouseout = function() { this.style.borderColor = '#323439'; this.style.background = '#1b1c1e'; };
                
                li.onclick = function() { openView(c); };

                const writerName = c.doctorName || c.doctorId;
                const writerMajor = c.doctorMajor ? `(${c.doctorMajor})` : '';
                const dateStr = new Date(c.savedAt).toLocaleString();
                const realName = findPatientName(c.patientId, c.patientName);
                const realDept = findDeptName(c.patientId, c.deptName);

                const itemJson = JSON.stringify(c).replace(/"/g, '&quot;');
                const sData = c.soapData || {};
                const showSummary = cleanSummary(sData.a || sData.s || '내용 없음');

                li.innerHTML = `
                    <div style="display:flex; flex-direction:column; gap:7px;">
                        <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                            <div>
                                <span class="common-badge badge-dept">${realDept}</span>
                                <span class="common-badge badge-patient">${realName} (${c.patientId})</span>
                            </div>
                            <div class="list-btn-group">
                                <button class="pdf-btn" onclick="event.stopPropagation(); saveAsPDF(${itemJson})">📄 PDF</button>
                                <button class="del-btn" onclick="event.stopPropagation(); deleteChart(${c.id})">삭제</button>
                            </div>
                        </div>

                        <div style="font-size:0.82em; color:var(--text-muted);">
                            <span>${dateStr}</span>
                            <span style="margin: 0 5px; opacity: 0.4;">|</span>
                            <span class="writer-name">${writerName}<span class="writer-major">${writerMajor}</span></span>
                        </div>

                        <div style="color:var(--text-primary); font-weight:bold; font-size:0.96em; line-height: 1.4; white-space: normal; word-break: break-all;">
                            ${showSummary}
                        </div>
                    </div>
                `;
                fragment.appendChild(li);
            });

            ul.appendChild(fragment);
        }

        window.electronAPI.on('auto-sync-updated', () => {
            console.log("⚡ [실시간 감지] 새 차트가 들어와 목록을 자동으로 갱신합니다.");
            refreshAllData();
        });
    </script>
</body>
</html>